// eShark — Firestore Security Rules (HARDENED)
// Deploy: firebase deploy --only firestore:rules
//
// Princípios:
//  - Default DENY (zero confiança)
//  - Validação de schema, tamanho e tipo no servidor
//  - Rate limit via "writes counter" por usuário
//  - Imutabilidade de campos críticos (ts, uid, productId)
//  - Whitelist de plataformas e tamanhos máximos

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn()        { return request.auth != null; }
    function isOwner(uid)      { return signedIn() && request.auth.uid == uid; }
    function isStr(v, maxLen)  { return v is string && v.size() <= maxLen; }
    function isInt(v, lo, hi)  { return v is int && v >= lo && v <= hi; }
    function isNum(v)          { return v is number; }
    function notTooLargeDoc()  { return request.resource.size < 50 * 1024; }  // 50KB
    function isFutureSafeTs(v) { return v is timestamp && v <= request.time + duration.value(60, 's'); }
    function platformOk(p)     { return p in ['shopee','ml','amazon','magalu','aliexpress']; }
    function emailOk(v)        { return isStr(v, 120) && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }

    // Anti-flood: cada user tem um documento /rate/{uid} com contagem por janela
    function withinWriteLimit() {
      return !exists(/databases/$(database)/documents/rate/$(request.auth.uid))
        || get(/databases/$(database)/documents/rate/$(request.auth.uid)).data.windowStart < request.time - duration.value(60,'s')
        || get(/databases/$(database)/documents/rate/$(request.auth.uid)).data.count < 60;
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['uid','email','displayName','createdAt','prefs'])
                    && request.resource.data.uid == uid
                    && emailOk(request.resource.data.email)
                    && isStr(request.resource.data.displayName, 60)
                    && isFutureSafeTs(request.resource.data.createdAt);
      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isStr(request.resource.data.displayName, 60)
                    && notTooLargeDoc();
      allow delete: if isOwner(uid);
    }

    // ---------- FAVORITES (subcollection per user) ----------
    match /users/{uid}/favorites/{productId} {
      allow read:   if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && withinWriteLimit()
                    && isStr(productId, 40)
                    && request.resource.data.keys().hasOnly(['productId','ts'])
                    && request.resource.data.productId == productId
                    && isFutureSafeTs(request.resource.data.ts);
      allow delete: if isOwner(uid);
    }

    // ---------- CLICK LOG (afiliado) ----------
    match /users/{uid}/clicks/{clickId} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                    && withinWriteLimit()
                    && isStr(clickId, 40)
                    && request.resource.data.keys().hasOnly(['productId','platform','price','shipping','ts','sessionId'])
                    && isStr(request.resource.data.productId, 40)
                    && platformOk(request.resource.data.platform)
                    && isNum(request.resource.data.price) && request.resource.data.price >= 0 && request.resource.data.price <= 1000000
                    && isNum(request.resource.data.shipping) && request.resource.data.shipping >= 0
                    && isFutureSafeTs(request.resource.data.ts)
                    && isStr(request.resource.data.sessionId, 64);
      allow update: if false;   // imutável
      allow delete: if isOwner(uid);
    }

    // ---------- PRICE ALERTS ----------
    match /users/{uid}/alerts/{alertId} {
      allow read:   if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && withinWriteLimit()
                    && isStr(request.resource.data.productId, 40)
                    && isNum(request.resource.data.targetPrice)
                    && request.resource.data.targetPrice > 0
                    && request.resource.data.targetPrice < 1000000
                    && isFutureSafeTs(request.resource.data.ts);
      allow delete: if isOwner(uid);
    }

    // ---------- PRODUCTS (read-only para o app, escrita só via admin) ----------
    match /products/{productId} {
      allow read:  if true;     // catálogo público
      allow write: if false;    // somente Cloud Functions / backend service account
    }

    // ---------- RATE COUNTER (somente owner pode incrementar via Function) ----------
    match /rate/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;  // managed by Cloud Functions
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
